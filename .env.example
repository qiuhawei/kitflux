# Public site URL used for canonical links, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.kitflux.com

# Public contact email shown on Contact / Privacy / Terms (use a real inbox)
NEXT_PUBLIC_CONTACT_EMAIL=wyhoyau@gmail.com

# AdSense publisher ID — enables the head script for verification / ads
# Example: ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-3195860835704762

# Google Search Console — HTML tag method (only the content="..." value)
# Search Console → Ownership verification → HTML tag
# Example: NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=AbCdEf123...
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
